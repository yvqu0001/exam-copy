---
//@ts-nocheck
import '../../styles/reset.css';
import '../../styles/effects.css';
import '../../styles/global.css';
import '../../styles/typography.css';
import '../../styles/variables.css';

import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import Countdown from '../../components/Countdown.astro';
import Card from '../../components/Card.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Blobs from '../../components/Blobs.astro';
import Buttons from '../../components/Buttons.astro';
import Mail from '../../assets/mail.svg';

export async function getStaticPaths() {
  const endpoint =
    "https://tkndfhivujdlyksacqma.supabase.co/rest/v1/Dankort-oeremaerket?select=*";
  const key = "sb_publishable_MNgNlIAwa1Fk9Ub05gnGTw_IhTr0m_G";

  const response = await fetch(endpoint, { headers: { apikey: key } });
  const products = await response.json();

  return products.map((product) => ({
    params: {
      slug: product.title
        .toLowerCase()
        .replace(/\s+/g, '-')
    },
    props: { product },
  }));
}

// FIX: Her trækker vi dataen ud, så din HTML kan læse 'product'
const { product } = Astro.props;
---

<Layout title={product.title}>
  <div class="bg">
    <main>
      <Breadcrumbs overrideLabel={product.title} />
      <section class="product_grid main_section">
        <div class="hide-on-desktop">
          <Countdown/>
        </div>
        <div class="img">
          <img class="glass" src={product.image} alt={product.title} />
        </div>
        
        <div class="tekst_grid">
          <div>
            <div class="hide-on-mobile">
              <Countdown forceMobile={true} />
            </div>
            <h2>{product.title}</h2>
            <h3>{product.price},-</h3>
          </div>
          
          <div class="tekst_grid"> 
            <div class="size-selector">
              <h4>Størrelse</h4>
    
              {product.size && product.size.length === 1 ? (
                /* Hvis der kun er 1 størrelse (f.eks. One size), viser vi det bare som ren tekst */
                <p class="one-size-text">{product.size[0]}</p>
              ) : (
                /* Hvis der er flere størrelser (T-shirt, Sokker), viser vi dropdownen */
                <div class="size-buttons">
                  {product.size && product.size.map((s) => (
                    <button type="button" class="size-btn glass">
                      {s}
                    </button>
                  ))}
                </div>
              )}
            </div>

            <Buttons variant="red500" text="Giv mig besked ved lancering" icon={Mail}/>

            <div class="oplysninger">
              <div>
                <h4>Produktoplysninger</h4>
              </div>
              <div>
                <h5>Materiale</h5>
                <p>100% genanvendelige materialer</p>
              </div>
              <div>
                <h5>Produkt type</h5>
                <p>{product.type}</p>
              </div>
              <div>
                <h5>Beskrivelse</h5>
                <p>{product.description}</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <div class="green-blob">
      <Blobs 
      color="green"
      size="medium"/>
    </div>
    <div class="red-blob">
      <Blobs 
      color="red"
      size="medium"/>
    </div>
    <div class="yellow-blob">
      <Blobs 
      color="yellow"
      size="medium"/>
    </div>
    <div class="blue-blob">
      <Blobs 
      color="blue"
      size="medium"/>
    </div>
  </div>
</Layout> 

<script>
  const sizeButtons = document.querySelectorAll(".size-btn");

  sizeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      sizeButtons.forEach((btn) => btn.classList.remove("selected"));
      button.classList.add("selected");
    });
  });
</script>

<style>
  main {
    margin-bottom: var(--gap-xl);
  }
  .main_section {
		display: flex;
		flex-direction: column;
		gap: var(--gap-xl);
    padding: 0 1rem;
	}

  .bg {
    position: relative;
    overflow: hidden;
	}

  .product_grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-s);
    margin: 0 auto;
  }

  .product_grid img {
    border-radius: var(--radius-l);
    width: 100%;
  }
 
  .hide-on-mobile {
    display: none;
  }

  .tekst_grid {
    display: flex;
    flex-direction: column;
    gap: var(--gap-s);
  }
  
  .oplysninger {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .size-selector {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .size-buttons {
    display: flex;
    justify-content: space-between;
  }
  
  .size-btn {
    width: 15vw;
    height: 50px;
    border-radius: var(--radius-m);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }
  
  .size-btn:hover {
    background-color: rgba(var(--neutral-200-rgb), 0.5);
  }

  .size-btn.selected {
    background-color: rgba(var(--blue-300-rgb), 0.5);
  }

  html.dark .size-btn:hover {
    background-color: rgba(var(--neutral-800-rgb), 0.50);
  }

  html.dark .size-btn.selected {
    background-color: rgba(var(--blue-600-rgb), 0.5);
  }

  /* blobs */
  .green-blob {
		position: absolute;
		top: 500px;
		left: -250px;
	}

  .red-blob {
		position: absolute;
		top: 0px;
		right: -300px;
	}

  .yellow-blob {
		position: absolute;
		bottom: 0px;
		left: -300px;
	}

  .blue-blob {
		position: absolute;
		bottom: 0px;
		right: -300px;
	}

  /* Desktop version (Skærme over 768px) */
  @media (min-width: 769px) {
    main {
      padding-bottom: var(--gap-xxl);
    }
    .main_section {
      gap: var(--gap-xxl);
      padding: 0;
    }

    .product_grid {
      grid-template-columns: 1fr 1fr;
      max-width: 1200px;
    }

    .hide-on-mobile {
      display: block; /* eller 'contents' / 'flex' alt efter behov */
    }

    /* På desktop skal mobil-countdownen skjules */
    .hide-on-desktop {
      display: none;
    }

    h2 {
      margin-top: var(--gap-xl);
    }

    .size-btn {
      width: 7vw;
      height: 50px;
    }

    .green-blob {
      top: 100px;
      left: -200px;
    }

    .red-blob {
      top: 50px;
      right: 50px;
    }

    .yellow-blob {
      bottom: -100px;
      left: 500px;
    }

    .blue-blob {
      bottom: 50px;
      right: -100px;
    }
  }
</style>