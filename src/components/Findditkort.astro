---
import Blobs from '../components/Blobs.astro'
import Dankort from '../assets/mobil-rkort.svg';
import AndreKort from '../assets/mobil-gkort.svg';
import KombiKort from '../assets/mobil-bkort.svg';
import CardKarrusel from './CardKarrusel.astro';

const mineManuelleKort = [
    {
        type: "info",
        title: "Dankort",
        inlineSvg: Dankort,
        bulletPoints: [
            "Dansk betalingsløsning",
            "Lavere gebyrer for de danske butikker/webshops",
            "Donerer mindst én øre pr. transaktion til Den Danske Naturfond",
            "I tilfælde af krisesituation kan Dankort stadig bruges"
        ],
        clickable: false
    },
    {
        type: "info",
        title: "Andre kort",
        inlineSvg: AndreKort,
        bulletPoints: [
            "International betalingsløsning",
            "Sikker online betaling via. diverse sikkerheds aftaler (alt afhængigt af hvilken kortudsteder)",
            "Der kan være forskellige fordele som: rejseforskringer, lounge-adgag, cashback eller andre kundefordele",
            "Kan tilføjes i digitale wallets"
        ],
        clickable: false
    },
    {
        type: "info",
        title: "Kombikort",
        inlineSvg: KombiKort,
        bulletPoints: [
            "Både dansk- og international betalingsløsning",
            "Når du handler i Danmark/danske butikker eller webshops, bruges Dankortdelen.",
            "Når du handler i andre lande eller internationale butikker/webshops bruges den internationale del.",
            "Lavere gebyrer for de danske butikker/webshops",
            "Kan tilføjes i digitale wallets"
        ],
        clickable: false
    }
]
---
<section>
    <h2 id="findditkorth2">Forskel på <span class="fat">Dankort</span> - og andre kort</h2>
    <CardKarrusel items={mineManuelleKort} />
</section>
<div class="yellow-blob">
    <Blobs 
    color="yellow"
    size="small"/>
</div>

<style>
    section {
        z-index: 100;
    }

    .fat {
        font-weight: 700;
    }

    #findditkorth2{
        text-align: left;
        padding-bottom: 2rem;
    }

    .yellow-blob {
		position: absolute;
		top: 100px;
		left: 100px;
	}

/* DESKTOP VERSION */
    @media (min-width: 768px) {
        #findditkorth2{
            text-align: center;
            padding-bottom: 3rem;
        }

        .yellow-blob {
            top: 80px;
            left: 350px;
        }
    }
</style>