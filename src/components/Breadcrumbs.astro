---
//@ts-nocheck

interface Props {
  overrideLabel?: string;
}

const { overrideLabel } = Astro.props as Props;
const { pathname } = Astro.url;

// Split the path into segments and remove empty elements
const segments = pathname.split('/').filter(Boolean);

// Custom labels for specific segments
const customLabels = {
  find_dit_kort: "Find dit kort",
  sneak_peak: "Sneak peek",
  om_os: "Om os",
};

// Build breadcrumb objects for each step
const breadcrumbs = segments.map((segment, index) => {
  const url = '/' + segments.slice(0, index + 1).join('/');
  
  // Check if this is the last segment and we have an override (for product pages)
  let label = segment;
  
  if (index === segments.length - 1 && overrideLabel) {
    label = overrideLabel;
  } else if (customLabels[segment as keyof typeof customLabels]) {
    label = customLabels[segment as keyof typeof customLabels];
  } else {
    // Default: replace hyphens/underscores with spaces and capitalize
    label = segment
      .replace(/[_-]/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());
  }

  return { label, url };
});

const allBreadcrumbs = [{ label: 'Forside', url: '/' }, ...breadcrumbs];
---

<nav aria-label="Brødkrummesti" class="breadcrumbs">
  <ol itemscope itemtype="https://schema.org/BreadcrumbList">
    {allBreadcrumbs.map((crumb, index) => {
      const isLast = index === allBreadcrumbs.length - 1;
      
      return (
        <li 
          itemprop="itemListElement" 
          itemscope 
          itemtype="https://schema.org/ListItem"
        >
          {isLast ? (
            // Sidste element (det aktuelle sidetrin) skal ikke være et link
            <span itemprop="name" aria-current="page">{crumb.label}</span>
          ) : (
            // De mellemliggende trin er klikbare links
            <a itemprop="item" href={crumb.url}>
              <span itemprop="name">{crumb.label}</span>
            </a>
          )}
          <meta itemprop="position" content={String(index + 1)} />
          
          {/* Vis en separator (f.eks. en skråstreg), hvis det ikke er sidste element */}
          {!isLast && <span class="separator" aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs{
    padding-top: 6rem;
    margin: var(--gap-xl) 0;
  }

  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    gap: 0.5rem;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumbs a {
    color: var(--neutral-800);
    text-decoration: none;
    position: relative;
  }

  /* Underline animation */
  .breadcrumbs a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .breadcrumbs a:hover::after {
    transform: scaleX(1);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--neutral-600);
    user-select: none;
  }

  .breadcrumbs .separator {
    color: var(--neutral-800);
    user-select: none;
  }


  /* Dark mode */
  html.dark .breadcrumbs a,
  html.dark .breadcrumbs .separator {
    color: var(--neutral-400);
  }

  html.dark .breadcrumbs [aria-current="page"] {
    color: var(--neutral-300);
  }

  @media (max-width:768px) {
    .breadcrumbs{
        padding-top: 4rem;
        margin: var(--gap-xl) 1rem;
    }
  }
</style>